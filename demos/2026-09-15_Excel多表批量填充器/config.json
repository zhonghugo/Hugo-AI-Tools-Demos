{
  "_说明": "Excel多表批量填充器 配置文件。新项目只需复制本文件并修改映射，无需改代码。",
  "源表": "sample_data/合同清单.xlsx",
  "源表Sheet": "合同明细",
  "目标表": [
    {
      "文件": "sample_data/对内台账.xlsx",
      "Sheet": "台账",
      "起始行": 2,
      "列映射": [
        { "源列": "合同编号", "目标列": "A" },
        { "源列": "项目名称", "目标列": "B" },
        { "源列": "供应商",   "目标列": "C" },
        { "源列": "合同金额", "目标列": "D" },
        { "源列": "签订日期", "目标列": "F" },
        { "源列": "负责人",   "目标列": "G" }
      ],
      "固定单元格": {
        "I1": "填表人：张会计",
        "I2": "填表日期：{{今天}}"
      }
    },
    {
      "文件": "sample_data/对外报表.xlsx",
      "Sheet": "对外报表",
      "起始行": 2,
      "列映射": [
        { "源列": "合同编号", "目标列": "B" },
        { "源列": "项目名称", "目标列": "C" },
        { "源列": "合同金额", "目标列": "D" },
        { "源列": "签订日期", "目标列": "E" },
        { "源列": "备注",     "目标列": "F" }
      ]
    },
    {
      "文件": "sample_data/合规检查表.xlsx",
      "Sheet": "合规检查",
      "起始行": 2,
      "列映射": [
        { "源列": "合同编号", "目标列": "A" },
        { "源列": "项目名称", "目标列": "B" },
        { "源列": "供应商",   "目标列": "C" },
        { "源列": "合同金额", "目标列": "D" },
        { "源列": "付款方式", "目标列": "E" },
        { "源列": "负责人",   "目标列": "G" }
      ]
    },
    {
      "文件": "sample_data/付款计划表.xlsx",
      "Sheet": "付款计划",
      "起始行": 2,
      "列映射": [
        { "源列": "合同编号", "目标列": "A" },
        { "源列": "项目名称", "目标列": "B" },
        { "源列": "供应商",   "目标列": "C" },
        { "源列": "合同金额", "目标列": "D" },
        { "源列": "付款方式", "目标列": "E" }
      ],
      "列值转换": {
        "E": {
          "分三期": "0.40",
          "预付30%": "0.30",
          "按季度": "0.25",
          "预付50%": "0.50",
          "按年度": "0.20",
          "分两期": "0.50",
          "预付40%": "0.40"
        }
      }
    }
  ]
}
